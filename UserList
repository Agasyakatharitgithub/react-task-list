import React,{useState, useEffect} from 'react';

function UserList(){
const [users, setUsers] = useState([]);
const [error, setError] = useState(null);
const [loading, setLoading] = useState(true);

const jsonUser = [
  {
    id: 1,
    name: "test1",
    address: {
      city: "Hyderabad"
    },
    company: {
      name: "Google"
    }
  },
  {
    id: 2,
    name: "test2",
    address: {
      city: "Bangalore"
    },
    company: {
      name: "Microsoft"
    }
  },
  {
    id: 3,
    name: "test3",
    address: {
      city: "Mumbai"
    },
    company: {
      name: "Amazon"
    }
  },
  {
    id: 4,
    name: "test4",
    address: {
      city: "Pune"
    },
    company: {
      name: "Infosys"
    }
  },
  {
    id: 5,
    name: "test5",
    address: {
      city: "Chennai"
    },
    company: {
      name: "Wipro"
    }
  }
];

const fetchUsers = async() =>{
try{
setError(null);

let res = await fetch("https://jsonplaceholder.typicode.com/users");
if(!res.ok){

  throw new Error("UNSABLE TO FETCH");
}

let data = await res.json();
setUsers(data);
console.log(data)

}catch(error){

setError(error.message);

}finally{

setLoading(false);
}}

useEffect(()=>{
fetchUsers();

},[])

//search
const[search, setSearch]=useState("");
let filteredUsers = users.filter(user => (user.name.toLowerCase().includes(search.toLowerCase())))

//sort
const[sortOrder, setSortOrder]= useState("asc");

let sortedUsers = [...filteredUsers].sort((a,b)=>{
  if(sortOrder === "asc"){
    return a.name.localeCompare(b.name);
  }else{
    return b.name.localeCompare(a.name);
  }
})

//pagination
const [currentPage, setCurrentPage] = useState(1);
let usersPerPage = 5;
let TotalPages = Math.ceil(sortedUsers.length/usersPerPage);
let startIndex = (currentPage - 1) * usersPerPage;
let endIndex = startIndex + usersPerPage;
let currentUser = sortedUsers.slice(startIndex,endIndex);

return(<>

<div className="container py-3">
<div className="card shadow">
<div className="card-header">
<h5 className="card-title d-flex align-items-center justify-content-center">Users </h5></div>
<div className="card-body">
<div className="row">
<div className="col-8">
<input  type="text" placeholder="search here" className="form-control mb-3" value={search} onChange={(e)=>setSearch(e.target.value)}></input>
</div>
<div className="col-4">
<select className="form-control mb-3" value={sortOrder} onChange={(e)=> setSortOrder(e.target.value)}><option value="asc">Ascending</option><option value="des">Descending</option></select>
</div>
</div>
<div className="table-responsive">
<table className="table table-bordered table-striped">
<thead className="table-dark">
<tr>
<th>Id</th>
<th>Name</th>
<th>Address</th>
<th>company</th>
</tr>

</thead>
<tbody>
  {currentUser.length > 0 ? (
currentUser.map(user =>(
<tr key ={user.id}>
<td>{user.id}</td>
<td>{user.name}</td>
<td>{user.address?.city}</td>
<td>{user.company?.name}</td>
</tr>

))):(<>

<div className="d-flex justify-content-center">No Records</div>
</>)}

<div>
<ul className="pagination">
<li className={`page-item ${currentPage === 1 ?'disabled':""}`}>
<button className="page-link"  onClick={()=>setCurrentPage(currentPage-1)}>Prev</button>

</li>
{Array.from({length:TotalPages},(_,index) => index + 1).map(page => 
<li key={page} className={`page-item ${currentPage === page ? "active" : ""}`}>
<button className="page-link" onClick={() => setCurrentPage(page)}>{page}</button></li>)}
<li className={`page-item ${currentPage === TotalPages ?'disabled':""}`}>
<button className="page-link" onClick={()=>setCurrentPage(currentPage+1)}>next</button>

</li>
</ul>
</div>
</tbody>
</table>
</div>
</div>
</div>
</div>

</>)

}
export default UserList;
